{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tirak-wiki-rag",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-18",
  "vars": {
    "ENVIRONMENT": "production",
    // Exact extra origins (comma-separated) allowed to call public chat, e.g. one
    // Vercel preview URL. https://wiki.tirak.app is always allowed (src/access.ts).
    // Wildcards are ignored on purpose.
    "ALLOWED_ORIGINS": ""
  },
  // Per-IP limit for public (no bearer) /v1/chat requests.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_CONFIG",
      "id": "44466b5466554e39acd6ff6249f9d43a"
    },
    {
      "binding": "APP_INDEX",
      "id": "d35d97749b384ccca61c92e331adc7c4"
    }
  ],
  "observability": {
    "enabled": true
  }
}
