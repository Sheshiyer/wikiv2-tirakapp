---
import { getCollection } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { isApprovedDocId } from '../../lib/approved-docs.mjs';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).filter(entry => isApprovedDocId(entry.slug));
  return docs.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<DocLayout title={entry.data.title} frontmatter={{ ...entry.data, slug: entry.slug }}>
  <Content />
</DocLayout>
