---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GlassCard } from '../components/GlassCard';
import { ArrowRight, CalendarCheck, Map, ShieldCheck } from 'lucide-react';
---

<BaseLayout title="Tirak — Guided Experiences in Thailand">
  <div class="space-y-16">
    <section class="text-center space-y-8 py-16 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-tirak-purple/20 rounded-full blur-[120px] -z-10"></div>

      <p class="text-lg md:text-xl font-medium text-tirak-pink tracking-wide uppercase">
        Tirak product source of truth
      </p>
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight">
        <span class="text-gradient">Guided experiences</span>
        <br />
        <span class="text-white">in Thailand.</span>
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto">
        Discover named food, culture, market, craft, and city activities with a clear itinerary,
        responsible local guide, confirmed booking, and total experience price.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/docs/01-introduction/welcome" class="bg-gradient-to-r from-tirak-pink to-tirak-purple text-white px-8 py-4 rounded-full font-semibold hover:opacity-90 transition-opacity flex items-center justify-center gap-2 shadow-lg shadow-tirak-purple/20 hover:shadow-tirak-purple/40 text-lg">
          Read the product contract <ArrowRight size={20} client:load />
        </a>
        <a href="/docs/02-foundation/messaging-framework" class="border border-white/20 text-white px-8 py-4 rounded-full font-semibold hover:bg-white/10 transition-colors flex items-center justify-center gap-2 text-lg">
          Use approved language
        </a>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <GlassCard className="p-8 !bg-white/5" client:visible>
        <Map className="text-tirak-pink mb-5" size={32} client:load />
        <h2 class="text-xl font-bold text-white mb-3">Experience first</h2>
        <p class="text-gray-300">Every booking begins with an activity, route, duration, meeting point, and inclusions.</p>
      </GlassCard>
      <GlassCard className="p-8 !bg-white/5" client:visible>
        <CalendarCheck className="text-tirak-pink mb-5" size={32} client:load />
        <h2 class="text-xl font-bold text-white mb-3">Confirm before payment</h2>
        <p class="text-gray-300">A local guide confirms the requested itinerary and date before checkout becomes available.</p>
      </GlassCard>
      <GlassCard className="p-8 !bg-white/5" client:visible>
        <ShieldCheck className="text-tirak-pink mb-5" size={32} client:load />
        <h2 class="text-xl font-bold text-white mb-3">Accountable travel</h2>
        <p class="text-gray-300">Credentials, booking records, logistics chat, reporting, support, and service reviews stay tied to the activity.</p>
      </GlassCard>
    </section>

    <section class="text-center py-12">
      <GlassCard className="p-12 !bg-gradient-to-br !from-[#F5A6BF]/10 !to-[#9B8FD9]/10" client:visible>
        <h2 class="text-3xl font-bold text-white mb-4">One release question</h2>
        <p class="text-gray-300 text-lg mb-6 max-w-2xl mx-auto">
          Which named guided experience is the traveler buying? Every screen and sentence must answer that clearly.
        </p>
        <a href="/docs/02-foundation/product-overview" class="inline-flex items-center gap-2 bg-gradient-to-r from-tirak-pink to-tirak-purple text-white px-8 py-4 rounded-full font-semibold hover:opacity-90 transition-opacity shadow-lg shadow-tirak-purple/20 text-lg">
          Open the current product overview
        </a>
      </GlassCard>
    </section>
  </div>
</BaseLayout>
